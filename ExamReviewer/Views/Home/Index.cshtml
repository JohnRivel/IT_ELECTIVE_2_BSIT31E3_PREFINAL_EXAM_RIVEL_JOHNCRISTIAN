@model List<Question>
@{
    ViewData["Title"] = "Exam";
}

<h2>Exam Review — @Model.Count Questions</h2>

@foreach (var item in Model)
{
    <a class="case-item" href="@Url.Action("Details", "Home", new { id = item.Id })">
        <span class="case-no">Question#@item.Id.ToString("00")</span>
        @item.Text
    </a>
}